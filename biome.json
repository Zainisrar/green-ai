{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!public",
      "!figma-mcp",
      "!.next",
      "!.next-dev",
      "!dist",
      "!build"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnknownProperty": "off",
        "noUnknownPseudoClass": "off",
        "useExhaustiveDependencies": "warn",
        "noUnreachable": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "useButtonType": "warn",
        "useSemanticElements": "warn",
        "noRedundantRoles": "off",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noAriaHiddenOnFocusable": "off",
        "useAriaPropsSupportedByRole": "warn",
        "useGenericFontNames": "off",
        "noLabelWithoutControl": "warn",
        "noRedundantAlt": "warn"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noArrayIndexKey": "off",
        "noDoubleEquals": "warn",
        "noDuplicateProperties": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
