    },
    {
      "id": "7077:2977",
      "name": "70% of global energy-related emissions originate in urban areas",
      "chars": "70% of global energy-related emissions originate in urban areas\r\n"
    },
    {
      "id": "7077:2979",
      "name": "75% of global energy demand is concentrated in cities",
      "chars": "75% of global energy demand is concentrated in cities\r\n"
    },
    {
